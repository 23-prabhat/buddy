# Copy to .env and fill in values. Never commit .env.

# Key mode: free | own | mock
#   free  = use FREE_AI_API_KEY (built-in free Groq)
#   own   = use AI_API_KEY (your key) + AI_PROVIDER
#   mock  = offline mock answers
AI_KEY_MODE=free

# Your personal key (when AI_KEY_MODE=own)
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
AI_BASE_URL=

# Built-in free tier (do not commit real production keys to public repos)
FREE_AI_API_KEY=
FREE_AI_PROVIDER=groq
FREE_AI_MODEL=llama-3.3-70b-versatile

# Providers: openai | groq | gemini | openrouter | deepseek | xai | nvidia | compatible | mock
# Examples after: provider openai gpt-4o-mini
#                 provider gemini gemini-2.0-flash
#                 provider deepseek deepseek-chat
#                 provider xai grok-2-latest
#                 provider nvidia nvidia/llama-3.1-nemotron-70b-instruct

# Note: Speech-to-Text and Text-to-Speech features have been removed.
# The "meeting" command now operates in text-only mode — feed lines with:
#   meeting start
#   meeting inject "why did you choose PostgreSQL?"
# and detected questions are auto-answered by the AI.

MEETING_CONTEXT_SECONDS=120
MEETING_AUTO_ANSWER=true

SCREEN_CAPTURE_ENABLED=true
SCREEN_MONITOR=1
SCREEN_FORCE_VISION=false
OCR_LANG=eng

HOTKEYS_ENABLED=true
RAG_ENABLED=true
RAG_PATH=

LOG_LEVEL=INFO
RESPONSE_STYLE=balanced
APP_MODE=general
